# Database (get a free Postgres instance from Supabase, Neon, or Railway)
DATABASE_URL="postgresql://user:password@host:5432/propman"

# Stripe (from dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Auth (from clerk.com — free tier is enough to start)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Tell Clerk to use our own sign-in/sign-up pages instead of its hosted portal
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Used to build the link inside tenant invite emails. Keep as localhost for
# local dev; set to your real domain once deployed.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Protects /api/cron/check-overdue from being triggered by randoms on the
# internet. Any random string works — generate one and keep it secret.
# Only needed in production if you set up a scheduler (see README).
CRON_SECRET="change-me-to-a-random-string"

# Resend (from resend.com — free tier is enough to start). Used to actually
# email tenants overdue-rent and lease-expiry reminders. Without this set,
# the app still runs fine — reminders just get logged instead of emailed.
RESEND_API_KEY="re_..."
EMAIL_FROM="PropMan <onboarding@resend.dev>"

# Your own email — whoever's Clerk account matches this can access
# /admin/requests to approve manual bank-transfer plan requests, and gets
# notified by email when a new one comes in.
ADMIN_EMAIL="you@example.com"
